{
 "autoname": "format:SP-NATIVE-{#####}",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "company",
  "posting_date",
  "outstanding_mode",
  "remarks",
  "amended_from",
  "lines"
 ],
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "default": "Today",
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Posting Date",
   "reqd": 1
  },
  {
   "default": "No",
   "fieldname": "outstanding_mode",
   "fieldtype": "Select",
   "label": "Update Outstanding",
   "options": "No\nYes",
   "reqd": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "no_copy": 1,
   "options": "SP Native Proof Voucher",
   "print_hide": 1,
   "read_only": 1
  },
  {
   "fieldname": "lines",
   "fieldtype": "Table",
   "label": "Proof Lines",
   "options": "SP Native Proof Line",
   "reqd": 1
  }
 ],
 "is_submittable": 1,
 "module": "Native Accounting Proof",
 "name": "SP Native Proof Voucher",
 "permissions": [
  {
   "amend": 1,
   "cancel": 1,
   "create": 1,
   "delete": 1,
   "read": 1,
   "role": "System Manager",
   "submit": 1,
   "write": 1
  }
 ],
 "track_changes": 1
}
